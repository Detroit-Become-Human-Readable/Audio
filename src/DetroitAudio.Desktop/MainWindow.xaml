<Window x:Class="DetroitAudio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DetroitAudio.Desktop" Title="Detroit Audio Browser" Width="1370" Height="860" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop">
  <Window.Style><Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}" /></Window.Style>
  <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" /><KeyBinding Key="Escape" Command="{Binding StopCommand}" /></Window.InputBindings>
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,13">
      <DockPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image x:Name="BrandLogo" Source="Assets/Logo.png" Width="42" Height="42" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Detroit logo" Cursor="Hand" MouseLeftButtonDown="OnBrandLogoClick" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform x:Name="BrandLogoRotation" Angle="0" /></Image.RenderTransform></Image><TextBlock Text="Detroit Audio Browser" Style="{DynamicResource HeadingTextStyle}" FontSize="21" Margin="0,0,24,0" VerticalAlignment="Center" /><Button Content="Open game" Command="{Binding OpenFolderCommand}" /><Button Content="Open file" Command="{Binding OpenFileCommand}" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExportAllButton" Content="Export All" Click="OnExportMenu" IsEnabled="{Binding HasLibrary}"><Button.ContextMenu><ContextMenu><MenuItem Header="Original media" Command="{Binding ExportAllOriginalCommand}" /><MenuItem Header="OGG" Command="{Binding ExportAllOggCommand}" /><MenuItem Header="WAV" Command="{Binding ExportAllWavCommand}" /></ContextMenu></Button.ContextMenu></Button><Button Content="Reindex" Command="{Binding ReindexCommand}" /><Button Content="Welcome" Command="{Binding WelcomeCommand}" /><Button Content="Tools" Command="{Binding ToolsCommand}" /></StackPanel></DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="180" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="420" /><ColumnDefinition Width="8" /><ColumnDefinition Width="300" MinWidth="220" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="0" Padding="10">
        <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Library" Style="{DynamicResource HeadingTextStyle}" Margin="8,7,0,12" FontSize="16" /><ItemsControl ItemsSource="{Binding QuickViews}" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding DataContext.SelectViewCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="3,0,3,8" /></StackPanel><TreeView x:Name="LibraryTree" ItemsSource="{Binding Roots}" SelectedItemChanged="OnTreeSelection"><TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type local:LibraryNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=TreeViewItem}}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" /></HierarchicalDataTemplate></TreeView.Resources></TreeView></DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="14,14,14,9"><TextBlock Text="{Binding ScopeText}" Style="{DynamicResource HeadingTextStyle}" Margin="0,0,0,9" TextTrimming="CharacterEllipsis" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search" ToolTip="Search names, IDs and dialogue" /><TextBlock IsHitTestVisible="False" Text="Search audio" Foreground="{DynamicResource MutedBrush}" Margin="11,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ComboBox Grid.Column="1" ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SearchScope}" AutomationProperties.Name="Search scope" Margin="8,0,0,0" /><Button Grid.Column="2" Content="Clear search" Command="{Binding ClearSearchCommand}" /></Grid></StackPanel>
          <WrapPanel Grid.Row="1" Margin="14,0,14,12"><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" AutomationProperties.Name="Language" /><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Type" /><CheckBox Content="Group similar audio" IsChecked="{Binding GroupSimilar}" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="Reset filters" Command="{Binding ResetFiltersCommand}" /><ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}" AutomationProperties.Name="Codec" /><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort" /><CheckBox Content="Descending" IsChecked="{Binding Descending}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /></WrapPanel>
          <DataGrid Grid.Row="2" x:Name="MediaGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionChanged="OnMediaSelection" MouseDoubleClick="OnMediaDoubleClick" Sorting="OnGridSorting" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="FullRow">
            <DataGrid.Columns><DataGridTemplateColumn Header="Name" Width="*" MinWidth="200" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel Margin="{Binding NameIndent}"><Button Content="{Binding ExpandGlyph}" Width="22" Height="23" Padding="0" Margin="0,0,4,0" Command="{Binding DataContext.ToggleGroupCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsGroupHeader}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridCell}}" /></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="105" SortMemberPath="ID" ElementStyle="{StaticResource IdentifierTextStyle}" /><DataGridTextColumn Header="Bank" Binding="{Binding BankName}" Width="155" SortMemberPath="Bank" /><DataGridTextColumn Header="Language" Binding="{Binding LanguageDisplay}" Width="85" SortMemberPath="Language" /><DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="85" SortMemberPath="Duration" /><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="85" SortMemberPath="Size" /></DataGrid.Columns>
            <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="Play" Command="{Binding PlayCommand}" /><MenuItem Header="Partial preview" Command="{Binding PartialPreviewCommand}" /><Separator /><MenuItem Header="Export original" Command="{Binding ExportOriginalCommand}" /><MenuItem Header="Convert to OGG" Command="{Binding ExportOggCommand}" /><MenuItem Header="Convert to WAV" Command="{Binding ExportWavCommand}" /></ContextMenu></DataGrid.ContextMenu>
          </DataGrid>
          <DockPanel Grid.Row="3" Margin="12,9"><TextBlock Text="{Binding ResultsText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></DockPanel>
          <TextBlock Grid.Row="2" Text="{Binding EmptyText}" Foreground="{DynamicResource MutedBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock Grid.Row="2" Text="Open a game folder or archive" Foreground="{DynamicResource MutedBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasLibrary}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />
      <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" CornerRadius="0" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{Binding SelectionName}" Style="{DynamicResource HeadingTextStyle}" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,12" />
          <StackPanel Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Margin="0,0,4,0" /><Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" Margin="4,0,0,0" /></Grid><Button Content="{Binding PartialPlayLabel}" Command="{Binding PartialPreviewCommand}" Margin="0,6,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasPartialPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding PlaybackMessage}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
          <StackPanel Grid.Row="2" Margin="0,12,0,14"><Slider Value="{Binding PositionSeconds}" Minimum="0" Maximum="{Binding LengthSeconds}" IsMoveToPointEnabled="True" AutomationProperties.Name="Seek" /><DockPanel Margin="0,4,0,9"><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding TotalTimeText}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" /></DockPanel><DockPanel><TextBlock Text="Volume" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" /><Slider Value="{Binding Volume}" Minimum="0" Maximum="1" AutomationProperties.Name="Volume" /></DockPanel></StackPanel>
          <TabControl Grid.Row="3"><TabItem Header="Details"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="10" Foreground="{DynamicResource TextBrush}" /></ScrollViewer></TabItem><TabItem Header="Event"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10"><StackPanel Margin="0,0,0,12"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRelatedPlayChoice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Playback event" Foreground="{DynamicResource MutedBrush}" /><ComboBox ItemsSource="{Binding RelatedPlayEvents}" SelectedItem="{Binding RelatedPlayEvent}" DisplayMemberPath="Name" Margin="0,5,0,0" AutomationProperties.Name="Playback event" /></StackPanel><TextBlock Text="Language" Foreground="{DynamicResource MutedBrush}" /><ComboBox ItemsSource="{Binding EventLanguages}" SelectedItem="{Binding EventLanguage}" Margin="0,5,0,12" /><TextBlock Text="Seed" Foreground="{DynamicResource MutedBrush}" /><TextBox Text="{Binding Seed}" Margin="0,5,0,12" /><TextBlock Text="Switches / states" Foreground="{DynamicResource MutedBrush}" /><TextBox Text="{Binding SwitchValues}" AcceptsReturn="True" MinHeight="65" Margin="0,5,0,12" ToolTip="Group ID = value ID, one per line" /><TextBlock Text="Loops" Foreground="{DynamicResource MutedBrush}" /><TextBox Text="{Binding Loops}" Margin="0,5,0,12" /><TextBlock Text="{Binding EventDetails}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /><Button Content="Play event" Command="{Binding PlayEventCommand}" Margin="0,12,0,0" /></StackPanel></ScrollViewer></TabItem><TabItem Header="Jobs"><ListBox ItemsSource="{Binding Jobs}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem></TabControl>
          <WrapPanel Grid.Row="4" Margin="0,12,0,0"><Button Content="Export" Click="OnExportMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="Selected original" Command="{Binding ExportOriginalCommand}" /><MenuItem Header="Export fragment bytes" Command="{Binding ExportFragmentCommand}" /><MenuItem Header="Filtered original" Command="{Binding ExportFilteredCommand}" /><Separator /><MenuItem Header="Bank" Command="{Binding ExportBankCommand}" /><MenuItem Header="Bank and media" Command="{Binding ExportBankMediaCommand}" /><Separator /><MenuItem Header="Event WAV" Command="{Binding ExportEventWavCommand}" /><MenuItem Header="Event OGG" Command="{Binding ExportEventOggCommand}" /></ContextMenu></Button.ContextMenu></Button><Button Content="Convert" Click="OnExportMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="Selected to OGG" Command="{Binding ExportOggCommand}" /><MenuItem Header="Selected to WAV" Command="{Binding ExportWavCommand}" /><Separator /><MenuItem Header="Filtered to OGG" Command="{Binding ConvertFilteredOggCommand}" /><MenuItem Header="Filtered to WAV" Command="{Binding ConvertFilteredWavCommand}" /></ContextMenu></Button.ContextMenu></Button><Button Content="Retry" Command="{Binding RetryCommand}" /></WrapPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Command="{Binding ShowTaskCommand}" ToolTip="{Binding CurrentTask.Phase}" Padding="2" Margin="0" BorderThickness="0"><ProgressBar Value="{Binding CurrentTask.Progress}" IsIndeterminate="{Binding CurrentTask.Indeterminate}" Maximum="100" Height="10" Width="174" IsHitTestVisible="False" /></Button><Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Padding="12,3" Margin="12,0,0,0" /></Grid></Border>
  </Grid>
</Window>
